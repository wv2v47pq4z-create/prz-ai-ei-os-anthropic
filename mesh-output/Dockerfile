# PRZ Health Service — Production Container
# Generated by: OPS agent

FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --production=false
COPY tsconfig.json ./
COPY src/ ./src/
RUN npx tsc

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV REGION=northamerica-northeast1
ENV PRZ_COMPLIANCE_MODE=STRICT
ENV LOG_LEVEL=info

# Security: non-root user
RUN addgroup -g 1001 -S prz && adduser -S prz -u 1001
COPY --from=builder --chown=prz:prz /app/dist ./dist
COPY --from=builder --chown=prz:prz /app/node_modules ./node_modules
COPY --from=builder --chown=prz:prz /app/package.json ./

USER prz
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["node", "dist/src/server.js"]
