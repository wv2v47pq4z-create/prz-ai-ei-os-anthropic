# PRZ AI/EI/OS Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# MongoDB Configuration
# =============================================================================
# MongoDB credentials (required only if not using connection URI)
MONGODB_USERNAME=your_username_here
MONGODB_PASSWORD=your_secure_password_here

# Or use a complete connection URI (overrides individual settings)
# MONGODB_URI=mongodb://username:password@host:port/database?authSource=admin

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PASSWORD=your_redis_password_here

# =============================================================================
# Firebase Configuration
# =============================================================================
# Firebase service account JSON (entire JSON as a single line)
# Get this from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# =============================================================================
# AWS DynamoDB Configuration
# =============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# =============================================================================
# Neo4j Configuration
# =============================================================================
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# =============================================================================
# Cassandra Configuration
# =============================================================================
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=your_cassandra_password_here

# =============================================================================
# Couchbase Configuration
# =============================================================================
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=your_couchbase_password_here

# =============================================================================
# PRZ Configuration
# =============================================================================

# GOOSEGUARD: Loop Detection Settings
# Time window for detecting repeated requests (milliseconds)
PRZ_LOOP_DETECTION_WINDOW_MS=300000

# Similarity threshold for loop detection (0.0 - 1.0)
PRZ_LOOP_SIMILARITY_THRESHOLD=0.8

# Resonance Engine: Thresholds
# Minimum resonance score for Green Lane execution (0.0 - 1.0)
PRZ_RESONANCE_THRESHOLD=0.95

# Feedback Processing: Adjustment Ranges
# Maximum resonance adjustment from positive feedback (0.0 - 1.0)
PRZ_MAX_POSITIVE_ADJUSTMENT=0.20

# Maximum resonance adjustment from negative feedback (0.0 - 1.0)
PRZ_MAX_NEGATIVE_ADJUSTMENT=0.20

# =============================================================================
# Application Settings
# =============================================================================

# Logging level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Node environment: development, production, test
NODE_ENV=development

# Maximum request length (characters)
MAX_REQUEST_LENGTH=10000

# =============================================================================
# Security Notes
# =============================================================================
# 1. Never commit this file with real credentials to version control
# 2. Use strong, unique passwords for each service
# 3. Rotate credentials regularly
# 4. Use AWS Secrets Manager or similar for production
# 5. Restrict file permissions: chmod 600 .env
